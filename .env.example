# =============================================================================
# ctrip-train-e2e 环境变量样例
# -----------------------------------------------------------------------------
# 用法：复制本文件为 .env 后按需修改（.env 已被 .gitignore 忽略，绝不入库）。
#       cp .env.example .env
# 说明：以下每个变量都有代码内默认值，绝大多数场景不填也能跑。
#       只有需要改目标站、改超时、或本地有头调试时才需要动。
#       本文件只列变量名与注释，**不含任何真实密钥或密码**。
#       （本工程不依赖 API Key / 数据库口令；登录态是真人扫码产生的
#        storage_state 文件，落在 config/auth/，已被 .gitignore 忽略。）
# =============================================================================

# ---------------------------------------------------------------- 目标站
# 三条轨道各自的入口 URL。留空则用 config/settings.py 里的默认值。
# 换站示例：BASE_URL=https://your-mirror.example.com
BASE_URL=
HOTEL_BASE_URL=
FLIGHT_BASE_URL=

# ---------------------------------------------------------------- 超时（毫秒）
DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=5000
NAV_TIMEOUT_MS=30000

# ---------------------------------------------------------------- 登录态
# 超过该天数只告警「建议重扫」，不阻断（mtime 说明不了是否还有效）。
AUTH_STATE_TTL_DAYS=7
# 是否给所有用例的浏览器上下文挂 storage_state。默认 0（关）。
# 设 1 会让酒店轨道的「匿名态」实验条件改变，读报告时需注意语义变化。
AUTH_GLOBAL=0
# test_logout.py 是否真的去点退出。默认 0（只验证退出入口，不真退）。
# 设 1 会烧掉当前登录态文件，本地调试用，慎用。
AUTH_REAL_LOGOUT=0

# ---------------------------------------------------------------- 浏览器
# 有头（可见窗口）模式。默认 0（无头）。设 1 会自动开启拟人节奏。
HEADED=0
# 物理窗口最大化（仅在有头时生效）。默认 1。
MAXIMIZE_WINDOW=1
# 营销浮层自动关闭。默认 1。设 0 关闭。
OVERLAY_AUTOCLOSE=1

# ---------------------------------------------------------------- 拟人节奏
# 留空=关；填一个 profile 名或 "1" 开启（只调时间、不碰身份）。
# CI 中恒为 0。
HUMAN=
# 拟人随机种子，填 0 以外整数可让节奏可复现。
HUMAN_SEED=0

# ---------------------------------------------------------------- 用例数据
# 覆盖默认的 data/ 目录（用例数据统一入口见 utils/case_data.py）。一般不用改。
CASE_DATA_DIR=

# ---------------------------------------------------------------- 报告清理
# 是否禁用 reports/ 下的自动清理。默认 0（开）。设 1 保留全部历史报告。
E2E_CLEAN_DISABLE=0
# 清理阈值（小时）：比这更旧的文件会被清。默认 24。
E2E_CLEAN_HOURS=24
# 干跑模式：只列出会删哪些，不真删。默认 0。设 1 预览。
E2E_CLEAN_DRY_RUN=0

# ---------------------------------------------------------------- Allure 报告
# 是否把 trace 挂进 Allure 产物。默认 0。设 1 便于事后排查。
E2E_TRACE=0
# JRE 17+ 安装目录（Allure CLI 需要 Java）。留空则回落 PATH 里的 java。
# 例：JAVA_HOME=C:/tools/jre-17
JAVA_HOME=
# Allure CLI 可执行文件路径。留空则回落 PATH 里的 allure。
# 例：ALLURE_BIN=C:/tools/allure-2.32.4/bin/allure
ALLURE_BIN=

# -----------------------------------------------------------------------------
# 以下变量由运行平台（GitHub Actions / CI）自动注入，请勿在 .env 里配置：
#   CI, GITHUB_ACTIONS, GITHUB_RUN_ID, GITHUB_STEP_SUMMARY
# -----------------------------------------------------------------------------
