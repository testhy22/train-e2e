# ---- 运行产物（绝不入库）----
reports/
*.zip
install.log
# CI 与本地临时取回的账本副本，真身在 ops/metrics 分支
.ledger/
# 用例轮换状态（每个功能上次跑到第几条）：跨运行的记忆，属运行产物的同类，
# 但它**不能**放 reports/ —— 清理器会按 mtime 删，删了等于每 24h 重置一轮覆盖。
.e2e-state/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# ---- 本地环境与凭据 ----
.env
.env.*
!.env.example
# 登录态 storageState：内容是**明文会话 cookie**，等价于账号凭据，绝不入库。
# 目录由 scripts/setup_auth.py 自己创建（含 .gitkeep 也不放，避免目录结构被误当成约定）。
config/auth/
# 兜底：state 被随手拷到仓库根、或有人用 launch_persistent_context 落了浏览器用户目录，
# 这两种产物都是凭据本体，名字对不上 config/auth/ 就漏了 —— 按文件名再挡一层。
auth_state.json
*_state.json
chrome_profile/
.user-data-dir/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Node 工具（node-tools/，2026-11-02 新增）----
# 依赖目录与运行产物；登录态/二维码/持久化 profile 都是凭据本体，绝不入库
node-tools/node_modules/
user-data/
auth-state.json
qr-code.png
